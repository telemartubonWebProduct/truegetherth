{
  "name": "truegetherth",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash scripts/e2e/run-local.sh",
    "db:start": "supabase start -x realtime,imgproxy,studio,postgres-meta,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning --fail-on error",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "db:push:dev": "node scripts/supabase/push-dev.mjs",
    "db:push:dev:apply": "node scripts/supabase/push-dev.mjs --apply",
    "db:backup:dev": "node scripts/supabase/backup.mjs --dev",
    "db:backup:local": "node scripts/supabase/backup.mjs --local",
    "db:restore:local": "node scripts/supabase/restore-local.mjs",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "@google-analytics/data": "7.2.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "dotenv": "^16.4.7",
    "lenis": "1.3.26",
    "lucide-react": "1.51.0",
    "next": "16.4.0",
    "nodemailer": "10.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.28",
    "supabase": "2.118.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
